      "heading": "-0.03em",
      "label": "0.15em"
    }
  },
  "colors": {
    "archetype": "LUXURY & PERFORMANCE",
    "palette": {
      "primary_dark": "#0A0A0A",
      "surface_dark": "#141414",
      "card_dark": "#1A1A1A",
      "border_dark": "#2E2E2E",
      "gold_accent": "#D4AF37",
      "gold_hover": "#E5C158",
      "gold_muted": "rgba(212, 175, 55, 0.15)",
      "pure_white": "#FFFFFF",
      "muted_text": "#A3A3A3",
      "success": "#10B981",
      "error": "#EF4444"
    }
  },
  "visual_enhancers": {
    "glassmorphism": "backdrop-blur-xl bg-[#0A0A0A]/80 border border-[#D4AF37]/20 shadow-[0_8px_32px_rgba(0,0,0,0.8)]",
    "gold_glow": "drop-shadow-[0_0_12px_rgba(212,175,55,0.4)]",
    "border_gold": "border border-[#D4AF37]/30 hover:border-[#D4AF37] transition-colors duration-300",
