    "marketing": "grid-cols-1 md:grid-cols-12 gap-8",
    "dashboard": "grid-cols-1 md:grid-cols-4 gap-6",
    "bento": "grid grid-cols-1 md:grid-cols-12 gap-6"
  },
  "motion": {
    "transition_default": "all 0.3s cubic-bezier(0.4, 0, 0.2, 1)",
